{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WinPet",
  "version": "0.1.0",
  "identifier": "com.winpet.blobatar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5179",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WinPet",
        "label": "pet",
        "width": 360,
        "height": 380,
        "minWidth": 320,
        "minHeight": 340,
        "resizable": true,
        "fullscreen": false,
        "maximizable": false,
        "minimizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "shadow": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/WinPet/**/*",
          "$PICTURE/WinPet/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
